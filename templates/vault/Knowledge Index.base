filters:
  and:
    - file.ext == "md"
    - file.hasTag("knowledge")
    - '!file.inFolder("Templates")'
    - '!file.inFolder("Archive")'
views:
  - type: table
    name: Current knowledge
    filters: state == "current"
    order:
      - file.name
      - scope
      - source_revision
      - observed_date
      - correction_path
  - type: table
    name: Historical notes
    filters: state == "historical-source-report"
    order:
      - file.name
      - scope
      - state
      - observed_date
      - source_sha256
